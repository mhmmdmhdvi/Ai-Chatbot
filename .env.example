# Copy this file to .env for local development. Never commit the real .env.
COMPOSE_PROJECT_NAME=ai_chatbot

POSTGRES_DB=ai_chatbot
POSTGRES_USER=ai_chatbot
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false

# Keep disabled until the selected provider is permitted for the deployment region.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=800
AI_CONTEXT_MESSAGE_LIMIT=16
AI_CONTEXT_CHARACTER_LIMIT=24000
