# Copy this file to .env for local development. Never commit the real .env.
COMPOSE_PROJECT_NAME=ai_chatbot

POSTGRES_DB=ai_chatbot
POSTGRES_USER=ai_chatbot
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false

# AI configuration will be enabled only after the provider is approved.
AI_PROVIDER=disabled
